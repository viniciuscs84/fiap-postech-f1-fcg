{
  "info": {
    "_postman_id": "1d4f2d5b-9b7f-4bfa-b8fd-f8cc0ef01001",
    "name": "FIAP Cloud Games - Fase 1",
    "description": "Coleção completa da API FCG Fase 1. O fluxo de compra e pagamento é externo; as operações de biblioteca registram apenas a associação entre usuário e jogo. Para um fluxo demonstrativo, execute primeiro Autenticação, depois Administração de Jogos e Promoções, Catálogo/Biblioteca e, por fim, as operações destrutivas de Administração de Usuários.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "urlBase", "value": "http://localhost:5285" },
    { "key": "nomeUsuario", "value": "Maria Silva" },
    { "key": "emailUsuario", "value": "maria@example.com" },
    { "key": "senhaUsuario", "value": "StrongPassword123!" },
    { "key": "emailAdministrador", "value": "admin@example.com" },
    { "key": "senhaAdministrador", "value": "Admin123!" },
    { "key": "tokenUsuario", "value": "" },
    { "key": "tokenAdministrador", "value": "" },
    { "key": "idUsuario", "value": "" },
    { "key": "idJogo", "value": "" },
    { "key": "idPromocao", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Cadastrar usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{nomeUsuario}}\",\n  \"email\": \"{{emailUsuario}}\",\n  \"password\": \"{{senhaUsuario}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{urlBase}}/api/auth/register",
            "description": "Cria um usuário comum. A senha deve atender às regras de segurança da API."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 ou 409', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('idUsuario', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Autenticar usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailUsuario}}\",\n  \"password\": \"{{senhaUsuario}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{urlBase}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('tokenUsuario', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Autenticar administrador",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdministrador}}\",\n  \"password\": \"{{senhaAdministrador}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{urlBase}}/api/auth/login",
            "description": "Usa o administrador criado pela migration de seed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('tokenAdministrador', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Catálogo de Jogos",
      "item": [
        {
          "name": "Listar jogos",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenUsuario}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{urlBase}}/api/games",
            "description": "Lista o catálogo para os papéis User ou Administrator."
          }
        },
        {
          "name": "Consultar jogo por ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenUsuario}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{urlBase}}/api/games/{{idJogo}}"
          }
        }
      ]
    },
    {
      "name": "3. Biblioteca de Jogos",
      "item": [
        {
          "name": "Consultar minha biblioteca",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenUsuario}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{urlBase}}/api/library/me"
          }
        },
        {
          "name": "Associar jogo à minha biblioteca",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenUsuario}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": "{{urlBase}}/api/library/me/games/{{idJogo}}",
            "description": "Registra a associação do jogo ao usuário autenticado. Compra, cobrança e pagamento são externos. A operação não possui corpo de requisição."
          }
        }
      ]
    },
    {
      "name": "4. Administração de Usuários",
      "item": [
        {
          "name": "Listar usuários",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdministrador}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{urlBase}}/api/admin/users"
          }
        },
        {
          "name": "Consultar usuário por ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdministrador}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{urlBase}}/api/admin/users/{{idUsuario}}"
          }
        },
        {
          "name": "Associar jogo a um usuário",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdministrador}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": "{{urlBase}}/api/admin/users/{{idUsuario}}/games/{{idJogo}}",
            "description": "Concede um jogo a um usuário após confirmação externa da compra ou pagamento. A operação não possui corpo de requisição."
          }
        },
        {
          "name": "Alterar papel do usuário",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdministrador}}", "type": "string" }] },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"User\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{urlBase}}/api/admin/users/{{idUsuario}}/role",
            "description": "Os valores de contrato aceitos pela API são User ou Administrator. O administrador não pode alterar o próprio papel."
          }
        },
        {
          "name": "Excluir usuário",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdministrador}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": "{{urlBase}}/api/admin/users/{{idUsuario}}",
            "description": "Operação destrutiva. Execute por último no fluxo de demonstração. O administrador não pode excluir a própria conta."
          }
        }
      ]
    },
    {
      "name": "5. Administração de Jogos e Promoções",
      "item": [
        {
          "name": "Cadastrar jogo",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdministrador}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Halo Infinite\",\n  \"description\": \"Jogo de tiro em primeira pessoa de ficção científica\",\n  \"genre\": \"Tiro\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{urlBase}}/api/admin/games"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('idJogo', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cadastrar promoção",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdministrador}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Semana Gamer\",\n  \"code\": \"GAMER25\",\n  \"discountPercentage\": 25,\n  \"startsAtUtc\": \"2026-09-01T00:00:00Z\",\n  \"endsAtUtc\": \"2026-09-08T00:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{urlBase}}/api/admin/promotions",
            "description": "O cadastro da promoção é administrativo; a aplicação do desconto em uma compra não faz parte da Fase 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 ou 409', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('idPromocao', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
