{
  "info": {
    "_postman_id": "1d4f2d5b-9b7f-4bfa-b8fd-f8cc0ef01fcg",
    "name": "FIAP Cloud Games - Fase 1",
    "description": "Collection completa da API FCG Fase 1. O fluxo de compra e pagamento é externo; as operações de biblioteca registram apenas a associação entre usuário e jogo. Para um fluxo demonstrativo, execute primeiro Autenticação, depois Administração > Jogos, Catálogo/Biblioteca e por fim as operações destrutivas de Administração > Usuários.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5285" },
    { "key": "userName", "value": "Maria Silva" },
    { "key": "userEmail", "value": "maria@example.com" },
    { "key": "userPassword", "value": "StrongPassword123!" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Admin123!" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "gameId", "value": "" },
    { "key": "promotionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Cadastrar usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Cria um usuário comum. A senha deve atender às regras de segurança da API."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 ou 409', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('userId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('userToken', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Usa o administrador criado pela migration de seed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('adminToken', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Catálogo",
      "item": [
        {
          "name": "Listar jogos",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/games",
            "description": "Lista o catálogo para User ou Administrator."
          }
        },
        {
          "name": "Consultar jogo por ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/games/{{gameId}}"
          }
        }
      ]
    },
    {
      "name": "3. Biblioteca",
      "item": [
        {
          "name": "Consultar minha biblioteca",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/library/me"
          }
        },
        {
          "name": "Associar jogo à minha biblioteca",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/library/me/games/{{gameId}}",
            "description": "Registra a associação do jogo ao usuário autenticado. Compra, cobrança e pagamento são externos. Não há body."
          }
        }
      ]
    },
    {
      "name": "4. Administração - Usuários",
      "item": [
        {
          "name": "Listar usuários",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users"
          }
        },
        {
          "name": "Consultar usuário por ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}"
          }
        },
        {
          "name": "Associar jogo a um usuário",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}/games/{{gameId}}",
            "description": "Concede um jogo a um usuário após confirmação externa da compra/pagamento. Não há body."
          }
        },
        {
          "name": "Alterar papel do usuário",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"User\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/users/{{userId}}/role",
            "description": "Valores aceitos: User ou Administrator. O administrador não pode alterar o próprio papel."
          }
        },
        {
          "name": "Excluir usuário",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}",
            "description": "Operação destrutiva. Execute por último no fluxo de demonstração. O administrador não pode excluir a própria conta."
          }
        }
      ]
    },
    {
      "name": "5. Administração - Jogos e Promoções",
      "item": [
        {
          "name": "Cadastrar jogo",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Halo Infinite\",\n  \"description\": \"Sci-fi first-person shooter\",\n  \"genre\": \"Shooter\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/games"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('gameId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cadastrar promoção",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Semana Gamer\",\n  \"code\": \"GAMER25\",\n  \"discountPercentage\": 25,\n  \"startsAtUtc\": \"2026-09-01T00:00:00Z\",\n  \"endsAtUtc\": \"2026-09-08T00:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/promotions",
            "description": "O cadastro da promoção é administrativo; a aplicação do desconto em checkout não faz parte da Fase 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 ou 409', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('promotionId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
