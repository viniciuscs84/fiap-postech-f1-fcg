  <diagram id="library-flow" name="Biblioteca - Aquisição e Consulta">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Biblioteca de jogos adquiridos" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="700" height="40" as="geometry" /></mxCell>
        <mxCell id="external" value="Compra/pagamento externo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="boundary" value="FCG não processa cobrança nem pagamento. A API registra somente a concessão do jogo à biblioteca após confirmação externa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="760" height="80" as="geometry" /></mxCell>

        <mxCell id="user" value="Usuário autenticado" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="50" height="80" as="geometry" /></mxCell>
        <mxCell id="self-acquire" value="POST /api/library/me/games/{gameId}&#xa;Comando: associar jogo à própria biblioteca" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="310" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="self-auth" value="Policy UserOrAdministrator&#xa;UserId vem exclusivamente do JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="310" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="game-check" value="Validar jogo no catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="320" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="duplicate-check" value="Invariante: usuário+jogo é único&#xa;verificar aquisição existente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1030" y="310" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="acquired" value="Criar AcquiredGame&#xa;UserId + GameId + AcquiredAtUtc&#xa;e persistir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1320" y="300" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="self-result" value="201 Created&#xa;404 jogo inexistente&#xa;409 já adquirido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1600" y="310" width="170" height="90" as="geometry" /></mxCell>

        <mxCell id="admin" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="610" width="50" height="80" as="geometry" /></mxCell>
        <mxCell id="admin-acquire" value="POST /api/admin/users/{userId}/games/{gameId}&#xa;Comando: conceder jogo a usuário" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="590" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="admin-auth" value="Policy AdministratorOnly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="user-check" value="Validar usuário alvo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="750" y="600" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="admin-game-check" value="Validar jogo no catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="990" y="600" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="admin-duplicate" value="Verificar associação existente&#xa;usuário+jogo único" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1240" y="590" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="admin-state" value="Persistir AcquiredGame para o usuário alvo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1510" y="590" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="admin-result" value="201 Created&#xa;404 usuário/jogo inexistente&#xa;409 duplicado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1510" y="720" width="220" height="90" as="geometry" /></mxCell>

        <mxCell id="query" value="GET /api/library/me&#xa;Query: consultar biblioteca" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="870" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="query-auth" value="Policy UserOrAdministrator&#xa;UserId vem do JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="450" y="865" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="query-read" value="Buscar AcquiredGames do usuário&#xa;incluir dados do Game&#xa;ordenar por AcquiredAtUtc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="730" y="850" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="query-result" value="200 OK&#xa;somente jogos pertencentes ao usuário autenticado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1040" y="865" width="260" height="90" as="geometry" /></mxCell>

        <mxCell id="e0" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="external" target="boundary"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="user" target="self-acquire"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;" edge="1" parent="1" source="self-acquire" target="self-auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;" edge="1" parent="1" source="self-auth" target="game-check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;" edge="1" parent="1" source="game-check" target="duplicate-check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;" edge="1" parent="1" source="duplicate-check" target="acquired"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;" edge="1" parent="1" source="acquired" target="self-result"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;" edge="1" parent="1" source="admin" target="admin-acquire"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;" edge="1" parent="1" source="admin-acquire" target="admin-auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;" edge="1" parent="1" source="admin-auth" target="user-check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;" edge="1" parent="1" source="user-check" target="admin-game-check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;" edge="1" parent="1" source="admin-game-check" target="admin-duplicate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="endArrow=block;html=1;" edge="1" parent="1" source="admin-duplicate" target="admin-state"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="endArrow=block;html=1;" edge="1" parent="1" source="admin-state" target="admin-result"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="endArrow=block;html=1;" edge="1" parent="1" source="user" target="query"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="endArrow=block;html=1;" edge="1" parent="1" source="query" target="query-auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="endArrow=block;html=1;" edge="1" parent="1" source="query-auth" target="query-read"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="endArrow=block;html=1;" edge="1" parent="1" source="query-read" target="query-result"><mxGeometry relative="1" as="geometry" /></mxCell>
