  <diagram id="game-catalog-flow" name="Jogos - Catálogo">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Catálogo de jogos" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="30" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="admin" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="205" width="50" height="80" as="geometry" /></mxCell>
        <mxCell id="create" value="POST /api/admin/games&#xa;Comando: cadastrar jogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="140" y="190" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="auth" value="Policy AdministratorOnly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="validate" value="Validar título, descrição e gênero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="630" y="190" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="aggregate" value="Agregado Game&#xa;- Id único&#xa;- título&#xa;- descrição&#xa;- gênero&#xa;- CreatedByUserId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="890" y="165" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="persist" value="Persistir jogo no catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1150" y="190" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="created" value="201 Created&#xa;400 se inválido&#xa;401/403 se não autorizado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1390" y="180" width="220" height="90" as="geometry" /></mxCell>

        <mxCell id="user" value="Usuário / Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="50" height="80" as="geometry" /></mxCell>
        <mxCell id="list" value="GET /api/games&#xa;Query: consultar catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="430" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="list-auth" value="Policy UserOrAdministrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="410" y="430" width="210" height="70" as="geometry" /></mxCell>
        <mxCell id="list-read" value="Consulta somente leitura&#xa;AsNoTracking&#xa;ordenar por título" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="415" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="list-result" value="200 OK&#xa;lista do catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="430" width="190" height="70" as="geometry" /></mxCell>

        <mxCell id="get" value="GET /api/games/{gameId}&#xa;Query: consultar jogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="650" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="get-auth" value="Policy UserOrAdministrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="210" height="70" as="geometry" /></mxCell>
        <mxCell id="get-read" value="Localizar jogo por Id&#xa;consulta somente leitura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="670" y="650" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="get-result" value="200 OK&#xa;404 se inexistente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="650" width="190" height="70" as="geometry" /></mxCell>

